{
  "name": "studio-n-code",
  "version": "0.2.2",
  "private": true,
  "description": "A desktop coding studio with integrated Git tools and a focused editing workflow",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.mjs",
    "test:ui": "node --test tests/webview.browser.mjs",
    "icons": "node scripts/generate-icons.mjs",
    "check:release": "node scripts/check-release.mjs",
    "prepare:upstream": "node scripts/prepare.mjs",
    "build": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build.ps1",
    "dist:win": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/package-windows.ps1",
    "start": "node scripts/launch.mjs",
    "smoke": "node scripts/launch.mjs --smoke"
  },
  "engines": {
    "node": ">=24"
  },
  "devDependencies": {
    "@resvg/resvg-js": "2.6.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/nilsenj/studio-n-code.git"
  }
}
